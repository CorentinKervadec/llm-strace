# ----------------------------------------------------------------

# .gitignore for the llm-strace project

# ----------------------------------------------------------------

# 1. Python & Environment

# --------------------------------

# Ignore Python bytecode and cache

pycache/
*.py[cod]
*$py.class

# Ignore virtual environments

venv/
.venv/
env/
.env/

# 2. IDE & Editor Files

# --------------------------------

.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 3. Slurm & Job Logs

# --------------------------------

# Ignore logs from the master script

# (e.g., OLMo-2-0425-1B/slurm_logs_20/)

/slurm_logs/

# Ignore logs from the individual test scripts

slurm_logs/
logs/

# Ignore Slurm output files that might be created at the root

slurm-*.out
*.out
*.err

WORKBENCH.sh

# 4. Generated Data & Output

# --------------------------------

# Ignore all generated data files (this is the main output)

*.npz
*.pkl
*.txt

# Ignore all generated plots and reports

*.pdf
*.html
*.tsv

# 5. Generated Directories (Whitelist Strategy)

# --------------------------------

# Ignore all top-level directories

*/

# --- UN-IGNORE (Whitelist) ---

# Now, explicitly re-include the directories that ARE part of the repo.
!src/
!src/llm_graph/
!src/llm_hooked/
!src/llm_trace/
!src/modified_transformers/
!data/wikitext_40.txt
!data/dummy_40.txt
!data/README.md
!analyse/
!analyse/plots/
!find_max_context/
!test/
!utils/
!scripts/